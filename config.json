{
    "manifest_path": "data/manifest.json",
    "output_dir": "exp",
    "feature_type": "melspectrogram",
    "sample_rate": 16000,
    "n_mels": 80,
    "n_fft": 512,
    "hop_length": 160,
    "win_length": 400,
    "segment_duration": 3.0,
    "embedding_dim": 256,
    "num_speakers": 100,
    "batch_size": 32,
    "speakers_per_batch": 8,
    "samples_per_speaker": 4,
    "epochs": 50,
    "lr": 0.001,
    "loss_type": "combined",
    "aam_weight": 0.7,
    "proto_weight": 0.3,
    "aam_margin": 0.2,
    "aam_scale": 30,
    "val_split": 0.1,
    "gender_balanced": true,
    "num_workers": 4,
    "log_interval": 50
}
