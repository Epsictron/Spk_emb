{
    "manifest_path": "data/manifest.json",
    "output_dir": "exp",
    "min_duration": 5.0,
    "min_samples_per_speaker": 20,

    "feature_type": "melspectrogram",
    "sample_rate": 16000,
    "n_mels": 80,
    "n_fft": 512,
    "hop_length": 160,
    "win_length": 400,
    "segment_duration": 5.0,

    "embedding_dim": 256,
    "left_context_ms": 100,
    "right_context_ms": 0,

    "speakers_per_batch": 100,
    "samples_per_speaker": 8,
    "max_steps": 100000,
    "lr": 0.001,
    "warmup_steps": 1000,
    "grad_clip": 5.0,
    "amp": false,
    "seed": 42,

    "loss_type": "combined",
    "aam_weight": 1.0,
    "proto_weight": 0.0,
    "aam_margin": 0.2,
    "aam_scale": 30,

    "val_manifest_path": "data/val_manifest.json",
    "eval_samples_per_speaker": 10,
    "val_interval": 2000,
    "log_interval": 50,
    "num_workers": 4,
    "keep_last_n_checkpoints": 3,

    "ema_alpha": 0.1,
    "ema_warmup_steps": 2000,
    "diag_interval": 100,
    "diag_score_alpha": 0.05,
    "cold_speaker_limit": 500,
    "mix_sample_size": 500,

    "lr_finder": false,
    "lr_finder_start": 1e-7,
    "lr_finder_end": 1.0,
    "lr_finder_steps": 100,
    "lr_finder_auto": false,

    "augmentation": {
        "noise_prob": 0.0,
        "noise_file": null,
        "noise_snr_low": 0,
        "noise_snr_high": 15,
        "reverb_prob": 0.0,
        "reverb_file": null,
        "speed_prob": 0.0,
        "speed_factors": [0.9, 1.0, 1.1],
        "spec_aug_prob": 0.0,
        "freq_mask_width": 10,
        "time_mask_width": 20,
        "num_freq_masks": 1,
        "num_time_masks": 1
    }
}
