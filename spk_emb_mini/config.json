{
    "manifest_path": "data/train_manifest.json",
    "test_manifest_path": "data/test_manifest.json",
    "output_dir": "exp",

    "sample_rate": 16000,
    "n_mels": 80,
    "n_fft": 512,
    "hop_length": 160,
    "win_length": 400,
    "segment_duration": 3.0,
    "min_duration": 3.0,
    "min_samples_per_speaker": 5,

    "embedding_dim": 256,
    "speakers_per_batch": 32,
    "samples_per_speaker": 4,

    "max_steps": 50000,
    "lr": 0.001,
    "warmup_steps": 500,
    "restart_period": 10000,
    "grad_clip": 5.0,
    "accumulation_steps": 1,
    "aam_margin": 0.2,
    "aam_scale": 30,
    "label_smoothing": 0.1,

    "speed_perturb": true,
    "spec_augment": true,

    "val_interval": 2000,
    "log_interval": 50,
    "num_workers": 4,
    "seed": 42,
    "eval_samples_per_speaker": 10,

    "lr_finder": false,
    "lr_finder_start": 1e-7,
    "lr_finder_end": 1.0,
    "lr_finder_steps": 100
}
